# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Service role key — server-side only (bypasses RLS). NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Anthropic Claude API ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN

# ── Upstash QStash (agent ticks) ──────────────────────────────────────────────
# QStash schedules POST /api/agents/tick every 60s
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...
QSTASH_TOKEN=...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://al-manar-sim.vercel.app
# In dev, set to http://localhost:3000

# ── Optional: Vercel deployment ───────────────────────────────────────────────
# Set all of the above in Vercel > Settings > Environment Variables
# QStash webhook URL: https://YOUR_APP.vercel.app/api/agents/tick
